<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <rule name="NodeInspector" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^server.js\/debug[\/]?" />
        </rule>
        <rule name="StaticContent" stopProcessing="true">
          <match url="^\/admin\/.*" />
          <action type="Rewrite" url="public{REQUEST_URI}" />
        </rule>
        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="True" />
          </conditions>
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>
    <httpErrors existingResponse="PassThrough" />
    <iisnode
      nodeProcessCommandLine=""%programfiles%\nodejs\18.17.0\node.exe""
      watchedFiles="*.js;node_modules\*;routes\*.js;services\*.js;controllers\*.js"
      node_env="production"
      debuggingEnabled="false"
      loggingEnabled="true"
      logDirectory="D:\home\LogFiles\iisnode"
      maxLogFileSizeInKB="1048576"
      maxTotalLogFileSizeInKB="10485760"
      maxLogFiles="20"
    />
  </system.webServer>
</configuration>